{
  "name": "ai-learning-system",
  "version": "1.0.0",
  "private": true,
  "description": "AI 学习系统 monorepo",
  "scripts": {
    "dev": "npm run dev --prefix front/app",
    "build": "npm run build --prefix front/app",
    "preview": "npm run preview --prefix front/app",
    "dev:server": "make -C server dev",
    "dev:admin": "npm run dev --prefix front/admin",
    "install:all": "npm install --prefix front/app && npm install --prefix front/admin"
  }
}
